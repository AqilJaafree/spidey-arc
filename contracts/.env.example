# Arc testnet — every value below verified directly against the chain.
# Copy to .env and fill in. .env is gitignored.

ARC_RPC_URL=https://rpc.testnet.arc.network

# The optional ERC-20 interface over the native USDC balance (6 decimals).
# Native gas on Arc is 18 decimals — the same money, 1e12 apart. See §7.7.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# CCTP v2, Arc domain 26.
ARC_TOKEN_MESSENGER_V2=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
ARC_MESSAGE_TRANSMITTER_V2=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275

# Optional — each defaults to the deployer.
# REPORTER_ADDRESS=
# OPERATOR_ADDRESS=
# KEEPER_ADDRESS=

# Blockscout-based, and it accepts `forge verify-contract`.
ARC_EXPLORER_URL=https://testnet.arcscan.app

# Base Sepolia, for the Uniswap v3 executor fork test.
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com

# Signing comes from the CLI keystore, NOT from here:
#   forge script script/Deploy.s.sol --rpc-url arc_testnet \
#     --account spidey-deployer --broadcast
