{
  "name": "spidey",
  "version": "0.1.0",
  "private": true,
  "description": "USDC LP Vault — cross-chain yield router on Arc",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "api": "pnpm --filter @spidey/api dev",
    "api:start": "pnpm --filter @spidey/api start",
    "web": "pnpm --filter @spidey/web dev",
    "capture": "pnpm --filter @spidey/adapters capture",
    "keeper:report-nav": "pnpm --filter @spidey/keeper report-nav",
    "keeper:tick": "pnpm --filter @spidey/keeper tick"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
